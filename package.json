{
  "name": "@elva/plugin",
  "version": "1.0.0-alpha.4",
  "description": "Shared 11ty configuration and CLI for the elva starter theme.",
  "main": "index.js",
  "type": "module",
  "bin": {
    "elva": "cli/index.js"
  },
  "scripts": {
    "clean": "node cli/index.js clean",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:fix": "prettier . --write"
  },
  "license": "MIT",
  "allowScripts": {
    "sharp": true
  },
  "author": {
    "name": "Scott Evans",
    "url": "https://scott.ee",
    "email": "git@scott.ee"
  },
  "peerDependencies": {
    "@11ty/eleventy": "^3.0.0 || ^4.0.0-0",
    "@awesome.me/buildawesome": "^4.0.0-0"
  },
  "peerDependenciesMeta": {
    "@11ty/eleventy": {
      "optional": true
    },
    "@awesome.me/buildawesome": {
      "optional": true
    }
  },
  "dependencies": {
    "@11ty/eleventy-fetch": "^6.0.1",
    "@11ty/eleventy-img": "^7.1.1",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-rss": "^3.1.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@11ty/import": "^2.0.1",
    "@inquirer/prompts": "^8.8.0",
    "@minify-html/node": "^0.18.1",
    "@sindresorhus/slugify": "^4.0.1",
    "alpinejs": "^3.17.5",
    "browserslist": "^4.29.5",
    "cheerio": "^1.2.0",
    "dot-prop": "^10.2.0",
    "eleventy-plugin-embed-everything": "^1.21.2",
    "lightningcss": "^1.33.0",
    "markdown-it-anchor": "^10.1.0",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-image-figures": "^2.1.1",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-table-of-contents": "^1.3.0",
    "mime-types": "^3.0.2",
    "terser": "^5.51.2",
